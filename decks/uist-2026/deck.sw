                    "Why are they in tension?"
                  ]
                }
              ]
            }
            TextBox {
              x: 120
              y: 365
              width: 1510
              height: 660
              font: "body"
              fontSize: 55
              fontWeight: "400"
              lineHeight: 1.25
              color: ink
              align: "left"
              content: [
                List {
                  style: "disc"
                  items: [
                    ListItem {
                      content: [
                        "Current debuggers couple collecting execution data and analyzing it"
                      ]
                      spaceAfter: 22
                    }
                    ListItem {
                      content: [
