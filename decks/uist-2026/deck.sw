              fontSize: 36
              highlightedLines: [
                
              
                
              ]
              content: [
                Paragraph {
                  content: [
                    Span {
                      runId: "run-1"
                      content: """
                      def evaluate(node):
                          if isinstance(node, Num):
                              return node.value
                          left = evaluate(node.left)
                          right = evaluate(node.right)
                          match node.op:
                              case "+": result = left + right
                              case "*": result = left * right
                              case "^": result = left * right
                          return result
                    """
                      id: "object-16"
                    
                    }
