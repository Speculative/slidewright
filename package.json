{
  "name": "slides-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "check:staged": "node scripts/check-staged-files.mjs",
    "test:source-sync": "node --import tsx --test scripts/source-sync.test.ts",
    "test:commit-hook": "node --test scripts/check-staged-files.test.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:slide-cache": "node --import tsx --test slidewright/runtime/__test__/slide-cache.test.ts",
    "test:vscode-source": "node --import tsx --test extension/src/__test__/source-session.test.ts",
    "test:host-document": "node --import tsx --test slidewright/canvas/__test__/host-document.test.ts",
    "test:editor-changes": "node --import tsx --test slidewright/canvas/__test__/editor-changes.test.ts",
    "test:source-history": "node --import tsx --test slidewright/canvas/__test__/source-history.test.ts",
    "test:source-edits": "node --import tsx --test slidewright/canvas/__test__/source-edits.test.ts",
    "test:selection-mapping": "node --import tsx --test slidewright/canvas/__test__/selection-mapping.test.ts",
    "test:document-parsing": "node --import tsx --test slidewright/runtime/__test__/document-parsing.test.ts",
    "test:document": "node --import tsx --test slidewright/runtime/__test__/document.test.ts",
    "test:builds": "node --import tsx --test slidewright/runtime/__test__/builds.test.ts slidewright/runtime/__test__/loader-builds.test.ts slidewright/canvas/__test__/build-editing.test.ts",
    "test:parser": "tsx slidewright/runtime/__test__/parser.smoke.ts",
    "test:loader": "tsx slidewright/runtime/__test__/loader.smoke.ts",
    "test:ssr": "tsx slidewright/runtime/__test__/ssr.smoke.ts",
    "test:roundtrip": "tsx slidewright/runtime/__test__/round-trip.smoke.ts",
    "test:syntax": "tsx slidewright/canvas/__test__/syntax-highlighting.smoke.ts",
    "test:source-folding": "node --import tsx --test slidewright/canvas/__test__/source-folding.test.ts",
    "test:source-layout": "tsx slidewright/canvas/__test__/source-layout.smoke.ts",
    "test:element-clipboard": "node --import tsx --test slidewright/canvas/__test__/element-clipboard.test.ts",
    "test:media": "tsx slidewright/runtime/__test__/media.smoke.ts",
    "test:text-document": "tsx slidewright/runtime/__test__/text-document.smoke.ts",
    "test:rich-text": "tsx slidewright/canvas/__test__/rich-text.smoke.ts",
    "test": "npm run typecheck && npm run test:builds && npm run test:source-sync && npm run test:document && npm run test:document-parsing && npm run test:selection-mapping && npm run test:source-edits && npm run test:source-history && npm run test:editor-changes && npm run test:host-document && npm run test:vscode-source && npm run test:slide-cache && npm run test:parser && npm run test:loader && npm run test:ssr && npm run test:roundtrip && npm run test:syntax && npm run test:source-layout && npm run test:source-folding && npm run test:element-clipboard && npm run test:media && npm run test:text-document && npm run test:rich-text && npm run test:plateau-charts && npm run test:plateau-deck && npm run test:chapters",
    "test:e2e": "playwright test --grep-invert @perf",
    "test:perf": "playwright test --grep @perf",
    "slidewright": "tsx slidewright/cli/validate.ts",
    "code-server": "code-server --auth none --bind-addr 0.0.0.0:8080 /workspace",
    "extension:typecheck": "tsc -p extension/tsconfig.json --noEmit && tsc -p extension/src/webview/tsconfig.json --noEmit",
    "extension:build": "node extension/esbuild.mjs",
    "extension:watch": "node extension/esbuild.mjs --watch",
    "test:plateau-charts": "tsx slidewright/runtime/__test__/plateau-charts.smoke.ts",
    "test:plateau-deck": "tsx slidewright/runtime/__test__/plateau-deck.smoke.ts",
    "test:production": "npm run build && playwright test -c playwright.production.config.ts",
    "test:chapters": "tsx slidewright/runtime/__test__/chapters.smoke.ts"
  },
  "bin": {
    "slidewright": "slidewright/cli/validate.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fontsource/lato": "^5.2.7",
    "@fontsource/monaspace-neon": "^5.2.5",
    "@lezer/highlight": "^1.2.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.57.0",
    "prism-react-renderer": "^2.4.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.118.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.0",
    "playwright": "^1.59.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0"
  }
}
